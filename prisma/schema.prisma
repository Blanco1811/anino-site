datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model MigrationRun {
  id               String           @id @default(cuid())
  runId            String           @unique
  mode             String           // "dry_run", "execute", "rollback"
  status           String           // "started", "completed", "failed", "rolled_back"
  errorMessage     String?
  rollbackOfRunId  String?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  createdBy        String?
  usersCreated     Int              @default(0)
  agentsCreated    Int              @default(0)
  callsCreated     Int              @default(0)
  knowledgeCreated Int              @default(0)
  conflictsCount   Int              @default(0)
  reportJson       String?          // Log conflict details or rollback results
  
  users            User[]
  agents           Agent[]
  calls            Call[]
  knowledge        AgentKnowledge[]
}

model User {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String
  email             String            @unique
  password          String
  phone             String?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  legacyAccountId   Int?              @unique
  legacyBalance     Decimal?
  migrationRunId    String?
  migrationRun      MigrationRun?     @relation(fields: [migrationRunId], references: [id])
  
  agents            Agent[]
  whatsappSession   WhatsAppSession?
  businessProfile   BusinessProfile?
  customers         Customer[]
  wallet            Wallet?

  @@index([migrationRunId])
}

model Agent {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  phoneNumber   String?   // Optional during initial phase (before client numbers are purchased)
  purpose       String
  status        String    @default("waiting")
  tone          String[]  // Supported natively in PostgreSQL
  startTime     String?   // Made optional to support legacy null values
  endTime       String?   // Made optional to support legacy null values
  scheduledAt   DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls         Call[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  legacyAgentId  Int?              @unique
  imageUrl       String?   // For agent avatar image
  greeting       String?   // Legacy initial agent greeting
  voiceGender    String    @default("neutral") // male / female / neutral
  voiceName      String    @default("alloy")   // OpenAI realtime voice
  responseLength String    @default("normal")  // short / normal / detailed
  conversationStyle String @default("professional") // professional / warm / sales / calm
  migrationRunId String?
  migrationRun   MigrationRun?     @relation(fields: [migrationRunId], references: [id])
  knowledge      AgentKnowledge[]

  notificationEnabled   Boolean  @default(false)
  notificationWhatsapp  String?
  notificationEmail     String?
  notificationChannel   String   @default("whatsapp")
  notificationTrigger   String   @default("orders")

  @@index([migrationRunId])
}

model Call {
  id            String    @id @default(cuid())
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  number        String
  purpose       String
  status        String
  scheduledAt   DateTime?
  startedAt     DateTime? // Made optional to support legacy nulls (no fake timestamps)
  twilioSid     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  legacyCallId            Int?              @unique
  direction               String?
  tries                   Int?
  transcript              String?
  summary                 String?
  summaryType             String?
  actionRequired          String?
  recordingUrl            String?
  retellCallId            String?
  durationSeconds         Int?
  errorMessage            String?
  lastSchedulerAttemptAt  DateTime?
  endedAt                 DateTime?
  migrationRunId          String?
  migrationRun            MigrationRun?     @relation(fields: [migrationRunId], references: [id])

  @@index([migrationRunId])
}

model AgentKnowledge {
  id             String        @id @default(cuid())
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content        String
  link           String?
  title          String?
  legacyId       Int?          @unique
  migrationRunId String?
  migrationRun   MigrationRun? @relation(fields: [migrationRunId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([migrationRunId])
}

model WhatsAppSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionData String?  
  isActive    Boolean  @default(false)
  lastQR      String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  businessType          String
  description           String
  openingHours          String
  address               String
  deliveryAreas         String
  phone                 String
  whatsappNumber        String
  whatsappPhoneNumberId String?  // Meta phone number ID for inbound webhook filtering
  menuText              String
  faqText               String
  agentInstructions     String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  userId    String    // Scopes customer to the business owner
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  name      String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([phone, userId]) // Enforces phone uniqueness per business owner
}

model Message {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sender     String   // "customer" or "agent"
  text       String
  createdAt  DateTime @default(now())
}

model HomeCard {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String   @default("✨")
  imageUrl    String?
  href        String   @default("#")
  color       String   @default("blue")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default("main")
  logoUrl         String?
  heroLabel       String?
  heroTitleLine1  String?
  heroTitleLine2  String?
  heroDescription String?
  updatedAt       DateTime @updatedAt
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(14, 2)
  currency     String              @default("ILS")
  transactions WalletTransaction[]
  autoTopUp    AutoTopUpSettings?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         String   // topup | charge | credit | refund
  service      String?  // voice_agent | whatsapp_agent | whatsapp_marketing | social_marketing | email_marketing | phone_number | manual
  amount       Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 2)
  description  String
  referenceId  String?  @unique
  createdAt    DateTime @default(now())

  @@index([walletId, createdAt])
}

model AutoTopUpSettings {
  id                  String   @id @default(cuid())
  walletId            String   @unique
  wallet              Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(false)
  thresholdAmount     Decimal  @default(20) @db.Decimal(14, 2)
  topUpAmount         Decimal  @default(100) @db.Decimal(14, 2)
  monthlyLimitAmount  Decimal? @db.Decimal(14, 2)
  monthlyChargesLimit Int?
  monthKey            String?
  thisMonthAmount     Decimal  @default(0) @db.Decimal(14, 2)
  thisMonthCharges    Int      @default(0)
  lastTriggeredAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PricingSettings {
  id                               String   @id
  voiceAgentRetailPerMinute        Decimal  @default(0) @db.Decimal(14, 2)
  twilioPhoneRetailPerMinute       Decimal  @default(0) @db.Decimal(14, 2)
  voiceAgentEstimatedCostPerMinute Decimal  @default(0) @db.Decimal(14, 2)
  twilioPhoneEstimatedCostPerMinute Decimal @default(0) @db.Decimal(14, 2)
  targetGrossMargin                Decimal  @default(60) @db.Decimal(5, 2)
  currency                         String   @default("ILS")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}
